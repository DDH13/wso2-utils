createUpdates() {
  setopt localoptions extendedglob noshwordsplit
  local DEFAULT_REPO="wso2-enterprise/wso2-apim-internal"
  local PRODUCT="wso2am"
  local USAGE="Usage: createUpdates [-y] [--dry-run] [--deduce <original issue number | URL>]"
  local ASSUME_YES=false DRY_RUN=false DEDUCE=""

  # 1. Argument parsing
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        echo "$USAGE"
        echo "  Creates Proactive UMT updates for ${PRODUCT} by commenting '/umt create ...' on one"
        echo "  GitHub issue per APIM version. Prompts for the version/issue pairs, then the issue"
        echo "  type, the public issue (or Security Internal Git issue) and the best-case ETA (a"
        echo "  Thursday), which are shared by every issue in the run. A bare issue number assumes"
        echo "  ${DEFAULT_REPO}."
        echo "  --deduce <issue>  read the original issue: its [ForwardPort][x.y.z] issues become the"
        echo "                    version/issue pairs, and the security / public issue details are"
        echo "                    pre-filled (Enter accepts, or edit them)."
        echo "  -y                skip the confirmation prompt"
        echo "  --dry-run         print the comments without posting them"
        return 0
        ;;
      -y|--yes) ASSUME_YES=true ;;
      -n|--dry-run) DRY_RUN=true ;;
      --deduce)
        if [[ -z "$2" ]]; then
          echo "❌ Error: --deduce needs an issue number or URL."
          return 1
        fi
        DEDUCE="$2"; shift
        ;;
      --deduce=*) DEDUCE="${1#--deduce=}" ;;
      *)
        echo "❌ Error: Unknown argument: $1"
        echo "$USAGE"
        return 1
        ;;
    esac
    shift
  done

  if ! command -v gh >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    echo "❌ Error: gh (GitHub CLI) and jq are required."
    return 1
  fi

  local ISSUE_URL_RE='^https://github\.com/([^/]+/[^/]+)/issues/([0-9]+)/?$'
  local SEC_URL_RE='https://github\.com/wso2-enterprise/security-internals?/issues/[0-9]+'

  # Prompt with an editable default (Enter accepts it). Falls back to plain read
  # (blank = default) when stdin isn't a terminal.
  _createUpdates_ask() {
    local __var="$1" __prompt="$2" __def="$3" __in
    if [[ -t 0 ]]; then
      __in="$__def"
      vared -p "$__prompt" __in || return 1
    else
      read "__in?$__prompt" || return 1
      [[ -z "$__in" ]] && __in="$__def"
    fi
    : ${(P)__var::=$__in}
  }

  local -a VERSIONS REPOS NUMS
  local VER REF REPO NUM i DUP ANS

  # 2. Deduce from the original issue
  local DEF_SECURITY=n DEF_SEC_URL="" DEF_PUB_URL=""
  if [[ -n "$DEDUCE" ]]; then
    DEDUCE="${DEDUCE#\#}"
    local OREPO ONUM
    if [[ "$DEDUCE" =~ $ISSUE_URL_RE ]]; then
      OREPO="${match[1]}"; ONUM="${match[2]}"
    elif [[ "$DEDUCE" == <-> ]]; then
      OREPO="$DEFAULT_REPO"; ONUM="$DEDUCE"
    else
      echo "❌ Error: '$DEDUCE' is not an issue number or issue URL."
      return 1
    fi

    echo "🔎 Reading ${OREPO}#${ONUM}..."
    local OJSON OTEXT PORTS
    OJSON="$(gh issue view "$ONUM" -R "$OREPO" --json title,body,labels,comments)" || {
      echo "❌ Error: Could not fetch the original issue (see gh error above)."
      return 1
    }
    # Every cross-referenced [ForwardPort][x.y.z] issue.
    local CANDS STATUSES
    CANDS="$(gh api "repos/${OREPO}/issues/${ONUM}/timeline" --paginate \
      -q '.[] | select(.event=="cross-referenced") | .source.issue
          | select(.pull_request | not)
          | select(.title | test("\\[ForwardPort\\]\\[[0-9]+\\.[0-9]+\\.[0-9]+\\]"))
          | {v: (.title | capture("\\[ForwardPort\\]\\[(?<v>[0-9]+\\.[0-9]+\\.[0-9]+)\\]").v),
             repo: .repository.full_name, number, state, title, id: .node_id}' \
      | jq -s 'unique_by([.repo, .number])')" || {
      echo "❌ Error: Could not read the issue timeline."
      return 1
    }
    # Their project board Status (e.g. "APIM Patches" → Open / In Progress / PR Sent / UAT).
    # Needs the read:project scope (gh auth refresh -s read:project).
    STATUSES='{}'
    if [[ "$(jq 'length' <<<"$CANDS")" != 0 ]]; then
      STATUSES="$(gh api graphql -f query="{ nodes(ids: $(jq -c 'map(.id)' <<<"$CANDS")) {
          ... on Issue { id projectItems(first: 10) { nodes {
            fieldValueByName(name: \"Status\") { ... on ProjectV2ItemFieldSingleSelectValue { name } } } } } } }" \
        -q '[.data.nodes[] | select(. != null)
             | {key: .id, value: [.projectItems.nodes[].fieldValueByName.name // empty]}] | from_entries')" || {
        echo "⚠️  Could not read project Status (missing read:project scope?); using open/closed state."
        STATUSES='{}'
      }
    fi
    # Keep issues whose Status is Open, In Progress or PR Sent (no project → open issues only), one per
    # version. Lines: keep(y/n), version, repo, number, status, duplicates, title.
    PORTS="$(jq -r --argjson st "$STATUSES" '
        map(. + {status: (($st[.id] // []) | join(", "))})
        | map(. + {keep: (if .status == "" then .state == "open"
                          else ($st[.id] | any(ascii_downcase | . == "open" or . == "in progress" or . == "pr sent")) end)})
        | (map(select(.keep)) | group_by(.v) | map(first + {dups: length})) + map(select(.keep | not))
        | sort_by([(.v | split(".") | map(tonumber)), (.keep | not)])
        | .[] | [(if .keep then "y" else "n" end), .v, .repo, (.number|tostring),
                 (if .status == "" then .state else .status end), ((.dups // 1)|tostring), .title] | @tsv' \
      <<<"$CANDS")"

    OTEXT="$(jq -r '[.body, (.comments[].body)] | join("\n")' <<<"$OJSON")"
    DEF_SEC_URL="$(grep -oE "$SEC_URL_RE" <<<"$OTEXT" | head -1)"
    DEF_PUB_URL="$(grep -iE 'public git issue' <<<"$OTEXT" |
      grep -oE 'https://github\.com/[^/ ]+/[^/ ]+/issues/[0-9]+' | head -1)"
    [[ -z "$DEF_PUB_URL" ]] &&
      DEF_PUB_URL="$(grep -oE 'https://github\.com/wso2/[^/ ]+/issues/[0-9]+' <<<"$OTEXT" | head -1)"
    if [[ -n "$DEF_SEC_URL" ]] ||
       jq -e '[.labels[].name] | index("Type/Security")' <<<"$OJSON" >/dev/null; then
      DEF_SECURITY=y
    fi

    echo "   $(jq -r '.title' <<<"$OJSON")"
    echo
    local PK PV PR PN PS PD PT XNOTE
    while IFS=$'\t' read -r PK PV PR PN PS PD PT; do
      [[ -z "$PV" ]] && continue
      if [[ "$PK" != y ]]; then
        echo "   ⏭️  ${PV} → ${PR}#${PN} [${PS}]: not Open / In Progress / PR Sent, ignored"
        continue
      fi
      XNOTE=""
      (( PD > 1 )) && XNOTE=" ⚠️ ${PD} Open/In Progress/PR Sent issues for ${PV}, using this one"
      echo "   ${PV} → ${PR}#${PN} [${PS}]: ${PT}${XNOTE}"
      VERSIONS+=("$PV"); REPOS+=("$PR"); NUMS+=("$PN")
    done <<<"$PORTS"
    echo "   Security: ${DEF_SECURITY}${DEF_SEC_URL:+ (${DEF_SEC_URL})} | Public issue: ${DEF_PUB_URL:-none found}"
    echo

    if (( ${#VERSIONS} == 0 )); then
      echo "⚠️  No [ForwardPort][x.y.z] issues are linked to ${OREPO}#${ONUM}. Enter them manually."
    else
      ANS=""
      read "ANS?Use these ${#VERSIONS} issue(s)? [Y/n]: " || return 1
      if [[ "${(L)ANS}" == (n|no) ]]; then
        VERSIONS=() REPOS=() NUMS=()
      fi
    fi
  fi

  # 3. Version / issue pairs (manual)
  if (( ${#VERSIONS} == 0 )); then
    echo "Enter the APIM versions and their issues (blank version to finish)."
    while true; do
      VER=""
      read "VER?  APIM version (e.g. 4.5.0): " || break
      VER="${VER//[[:space:]]/}"
      [[ -z "$VER" ]] && break
      if [[ ! "$VER" =~ '^[0-9]+\.[0-9]+\.[0-9]+$' ]]; then
        echo "  ⚠️  '$VER' is not a version like 4.5.0."
        continue
      fi
      if (( ${VERSIONS[(Ie)$VER]} )); then
        echo "  ⚠️  ${VER} was already entered."
        continue
      fi

      REF=""
      read "REF?  Issue for ${VER} (number or URL): " || break
      REF="${REF//[[:space:]]/}"
      REF="${REF#\#}"
      if [[ "$REF" =~ $ISSUE_URL_RE ]]; then
        REPO="${match[1]}"; NUM="${match[2]}"
      elif [[ "$REF" == <-> ]]; then
        REPO="$DEFAULT_REPO"; NUM="$REF"
      else
        echo "  ⚠️  '$REF' is not an issue number or issue URL. Enter ${VER} again."
        continue
      fi
      DUP=false
      for (( i = 1; i <= ${#NUMS}; i++ )); do
        [[ "${REPOS[i]}" == "$REPO" && "${NUMS[i]}" == "$NUM" ]] && DUP=true
      done
      if [[ "$DUP" == true ]]; then
        echo "  ⚠️  ${REPO}#${NUM} is already used (one update per issue). Enter ${VER} again."
        continue
      fi

      VERSIONS+=("$VER"); REPOS+=("$REPO"); NUMS+=("$NUM")
    done
  fi

  if (( ${#VERSIONS} == 0 )); then
    echo "❌ Error: No version/issue pairs given."
    return 1
  fi

  # 4. Issue type
  local TYPE="" CHOICE
  while [[ -z "$TYPE" ]]; do
    CHOICE=""
    read "CHOICE?Issue type: 1) Bug  2) Improvement  3) Feature [1]: " || return 1
    case "${CHOICE//[[:space:]]/}" in
      ""|1|[Bb]ug) TYPE="Bug" ;;
      2|[Ii]mprovement) TYPE="Improvement" ;;
      3|[Ff]eature) TYPE="Feature" ;;
      *) echo "  ⚠️  Pick 1, 2 or 3." ;;
    esac
  done

  # 5. Security? -> Security Internal Git issue (required) or public issue (optional)
  local SECURITY=false LINK_FLAG="" LINK_URL="" HINT="[y/N]"
  [[ "$DEF_SECURITY" == y ]] && HINT="[Y/n]"
  ANS=""
  _createUpdates_ask ANS "Is this a security update? ${HINT}: " "$DEF_SECURITY" || return 1
  [[ "${(L)ANS}" == (y|yes) ]] && SECURITY=true
  if [[ "$SECURITY" == true ]]; then
    LINK_FLAG="--security-issue"
    while [[ -z "$LINK_URL" ]]; do
      _createUpdates_ask LINK_URL "Security Internal Git issue URL: " "$DEF_SEC_URL" || return 1
      LINK_URL="${LINK_URL//[[:space:]]/}"
      if [[ ! "$LINK_URL" =~ $ISSUE_URL_RE ]]; then
        echo "  ⚠️  A GitHub issue URL is required for a security update."
        LINK_URL="" DEF_SEC_URL=""
      elif [[ "${(L)match[1]}" != *security* ]]; then
        echo "  ⚠️  ${match[1]} doesn't look like a security-internal repo (keeping it anyway)."
      fi
    done
  else
    while true; do
      LINK_URL=""
      _createUpdates_ask LINK_URL "Public issue URL (blank for none): " "$DEF_PUB_URL" || return 1
      LINK_URL="${LINK_URL//[[:space:]]/}"
      [[ -z "$LINK_URL" || "${(L)LINK_URL}" == (n/a|na|none) ]] && { LINK_URL=""; break; }
      [[ "$LINK_URL" =~ $ISSUE_URL_RE ]] && { LINK_FLAG="--public-issue"; break; }
      echo "  ⚠️  Not a GitHub issue URL."
      DEF_PUB_URL=""
    done
  fi

  # 6. ETAs
  #    Only the best case is asked (always a Thursday); most likely = best + 1 week,
  #    worst = most likely + 2 weeks.
  local -a ETAS
  local D
  while true; do
    D=""
    read "D?ETA Best case, a Thursday (YYYY-MM-DD): " || return 1
    D="${D//[[:space:]]/}"
    if [[ ! "$D" =~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' ]] ||
       [[ "$(date -j -f %Y-%m-%d "$D" +%Y-%m-%d 2>/dev/null)" != "$D" ]]; then
      echo "  ⚠️  '$D' is not a valid YYYY-MM-DD date."
      continue
    fi
    if [[ "$(date -j -f %Y-%m-%d "$D" +%u)" != 4 ]]; then
      echo "  ⚠️  ${D} is a $(date -j -f %Y-%m-%d "$D" +%A), not a Thursday."
      continue
    fi
    break
  done
  ETAS=("$D"
        "$(date -j -v+7d -f %Y-%m-%d "$D" +%Y-%m-%d)"
        "$(date -j -v+21d -f %Y-%m-%d "$D" +%Y-%m-%d)")
  local ETA="${(j:,:)ETAS}"

  # 7. Check the issues and build the comments
  local -a TITLES BODIES SKIP
  local JSON TITLE STATE UMT_STATE NOTE LINK_ARG=""
  [[ -n "$LINK_FLAG" ]] && LINK_ARG=" ${LINK_FLAG} ${LINK_URL}"
  echo
  echo "🔎 Checking issues..."
  for (( i = 1; i <= ${#VERSIONS}; i++ )); do
    TITLE="" NOTE="" SKIP[i]=false
    if JSON="$(gh issue view "${NUMS[i]}" -R "${REPOS[i]}" --json title,state,labels 2>&1)"; then
      TITLE="$(jq -r '.title' <<<"$JSON")"
      STATE="$(jq -r '.state' <<<"$JSON")"
      UMT_STATE="$(jq -r '[.labels[].name | select(startswith("umt/state/"))] | first // empty' <<<"$JSON")"
      [[ "$STATE" == "CLOSED" ]] && NOTE+=" ⚠️ closed"
      if [[ -n "$UMT_STATE" ]]; then
        NOTE+=" ⏭️ already has an update (${UMT_STATE#umt/state/}), skipping"
        SKIP[i]=true
      fi
    else
      TITLE="❌ could not fetch issue"
      SKIP[i]=true
    fi
    TITLES[i]="$TITLE${NOTE}"
    BODIES[i]="/umt create --product ${PRODUCT} ${VERSIONS[i]} --type ${TYPE} --proactive --eta ${ETA}${LINK_ARG}"
  done

  # 8. Summary
  echo
  if [[ -n "$LINK_FLAG" ]]; then
    echo "Type: ${TYPE} | Proactive | ${LINK_FLAG#--}: ${LINK_URL}"
  else
    echo "Type: ${TYPE} | Proactive | no public issue"
  fi
  echo "ETA:  best ${ETAS[1]}, most likely ${ETAS[2]}, worst ${ETAS[3]}"
  echo
  local TODO=0
  for (( i = 1; i <= ${#VERSIONS}; i++ )); do
    echo "• ${PRODUCT} ${VERSIONS[i]} → ${REPOS[i]}#${NUMS[i]}: ${TITLES[i]}"
    if [[ "${SKIP[i]}" != true ]]; then
      echo "    ${BODIES[i]}"
      (( TODO++ ))
    fi
  done
  echo

  if (( TODO == 0 )); then
    echo "❌ Nothing to post."
    return 1
  fi
  if [[ "$DRY_RUN" == true ]]; then
    echo "ℹ️  Dry run: nothing posted."
    return 0
  fi
  if [[ "$ASSUME_YES" != true ]]; then
    ANS=""
    read "ANS?Post /umt create on ${TODO} issue(s)? [y/N]: " || return 1
    [[ "${(L)ANS}" == (y|yes) ]] || { echo "Aborted."; return 1; }
  fi

  # 9. Post
  local OK=0 FAIL=0
  for (( i = 1; i <= ${#VERSIONS}; i++ )); do
    [[ "${SKIP[i]}" == true ]] && continue
    if gh issue comment "${NUMS[i]}" -R "${REPOS[i]}" --body "${BODIES[i]}" >/dev/null; then
      echo "✅ ${VERSIONS[i]}: https://github.com/${REPOS[i]}/issues/${NUMS[i]}"
      (( OK++ ))
    else
      echo "❌ ${VERSIONS[i]}: failed to comment on ${REPOS[i]}#${NUMS[i]}"
      (( FAIL++ ))
    fi
  done
  echo
  echo "Posted ${OK}, failed ${FAIL}. The bot replies ⏳ then ✅ with the update link on each issue."
  (( FAIL == 0 ))
}
