# Function to clean, unpack, and configure a fresh WSO2 IS pack
# Usage: freshISPack <version_number>
freshISPack() {
  # 1. Check if a version argument was provided
  if [ -z "$1" ]; then
    echo "❌ Error: Please provide the WSO2 IS version number (e.g., 7.1.0)."
    echo "Usage: freshISPack <version_number>"
    return 1
  fi

  # 2. Define variables for paths and filenames
  local PACKS_DIR="/Users/dineth/Code/APIM-packs-patches"
  local MIN_ARM64_VERSION="7.2.0"
  local VERSION="$1"
  local PACK_NAME="wso2is-${VERSION}"
  local ZIP_FILE="${PACK_NAME}.zip"
  local EMAIL="${APIM_EMAIL:-dinethh@wso2.com}"

  # IS 7.2.0 onwards ships an arm64-native update tool (mirrors freshPack's
  # MIN_ARM64_VERSION check for AM).
  local UPDATE_TOOL
  if [[ "$(printf '%s\n%s' "$MIN_ARM64_VERSION" "$VERSION" | sort -V | head -n1)" == "$MIN_ARM64_VERSION" ]]; then
    UPDATE_TOOL="./wso2update_darwin_arm64"
  else
    UPDATE_TOOL="./wso2update_darwin"
  fi

  # --- NEW: Fetch Password Securely ---
  local WSO2_PASS
  if ! WSO2_PASS=$(security find-generic-password -a "$EMAIL" -s "wso2-update" -w 2>/dev/null); then
    echo "❌ Error: Password not found in Keychain for $EMAIL."
    echo "💡 Run this command once to save it: security add-generic-password -a \"$EMAIL\" -s \"wso2-update\" -w \"YOUR_PASSWORD\""
    return 1
  fi
  # ------------------------------------

  # 3. Navigate to the main directory
  echo "📂 Navigating to ${PACKS_DIR}"
  cd "$PACKS_DIR" || { echo "❌ Error: Directory not found: $PACKS_DIR"; return 1; }

  # 4. Check if the required zip file exists before starting
  if [ ! -f "$ZIP_FILE" ]; then
    echo "❌ Error: Zip file not found: $ZIP_FILE"
    return 1
  fi

  # 5. If an old unzipped directory exists, remove it
  if [ -d "$PACK_NAME" ]; then
    echo "🧹 Removing existing directory: ${PACK_NAME}"
    rm -rf "$PACK_NAME"
  fi

  # 6. Unzip the pack quietly
  echo "📦 Unzipping ${ZIP_FILE}..."
  unzip -q "$ZIP_FILE"

  # 7. Navigate into the /bin directory
  local BIN_DIR="${PACK_NAME}/bin"
  if [ -d "$BIN_DIR" ]; then
    echo "✅ Setup complete! Navigating to ${BIN_DIR}"
    cd "$BIN_DIR" || return 1

    # 8. Run the WSO2 update tool
    echo "🔄 Running the WSO2 update tool: $UPDATE_TOOL"

    # Some packs (e.g. arm64 builds) don't ship the update tool binary directly —
    # it has to be fetched first.
    if [ ! -f "$UPDATE_TOOL" ]; then
      echo "⚙️  Update tool binary missing. Running update_tool_setup.sh..."
      sh update_tool_setup.sh
    fi

    # Ensure the tool is executable
    chmod +x "$UPDATE_TOOL" 2>/dev/null || true

    # --- UPDATED: Pass the email and password flags ---
    "$UPDATE_TOOL" -u "$EMAIL" -p "$WSO2_PASS"
  else
    echo "❌ Error: Could not find the bin directory at ${BIN_DIR}"
    return 1
  fi
}